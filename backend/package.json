{
  "name": "thailand-my-car-backend",
  "version": "1.0.0",
  "description": "Backend API for Thailand My Car investment platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "db:migrate": "node --env-file=.env src/config/migrate.js",
    "db:migrate:missing": "node --env-file=.env src/config/migrate-missing.js",
    "db:migrate:all": "npm run db:migrate && npm run db:migrate:missing",
    "db:seed": "node --env-file=.env src/config/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "ethers": "^6.13.4",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {}
}