# Production Environment Configuration
# Copy this file and rename to .env.production on your VPS

# Application
NODE_ENV=production
PORT=80

# API URLs (use empty for relative paths, nginx will proxy /api/ to backend)
VITE_API_URL=
VITE_WS_URL=

# Blockchain Configuration
VITE_CHAIN_ID=56
VITE_CHAIN_NAME=BSC
VITE_RPC_URL=https://bsc-dataseed.binance.org/
VITE_EXPLORER_URL=https://bscscan.com

# Smart Contract Addresses (to be filled after deployment)
VITE_INVESTMENT_VAULT_ADDRESS=
VITE_INVESTOR_NFT_ADDRESS=
VITE_GOVERNANCE_TOKEN_ADDRESS=

# Analytics
VITE_GA_TRACKING_ID=
VITE_HOTJAR_ID=

# Feature Flags
VITE_ENABLE_INVESTMENTS=true
VITE_ENABLE_GOVERNANCE=true
VITE_MAINTENANCE_MODE=false
